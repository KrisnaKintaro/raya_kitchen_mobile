<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buyer_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/logo_app"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Daftar Akun Baru"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/buyer_textPrimary"
            android:textAlignment="center"
            android:layout_marginBottom="32dp" />

        <!-- Input Nama -->
        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Nama Lengkap"
            android:background="@color/buyer_surface"
            android:paddingHorizontal="16dp"
            android:textColor="@color/buyer_textPrimary"
            android:textColorHint="@color/buyer_textSecondary"
            android:elevation="2dp"
            android:layout_marginBottom="16dp" />

        <!-- Input WA -->
        <EditText
            android:id="@+id/etWhatsapp"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Nomor WhatsApp (Contoh: 8123...)"
            android:inputType="phone"
            android:background="@color/buyer_surface"
            android:paddingHorizontal="16dp"
            android:textColor="@color/buyer_textPrimary"
            android:textColorHint="@color/buyer_textSecondary"
            android:elevation="2dp"
            android:layout_marginBottom="16dp" />

        <!-- Input Password -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Password"
                android:inputType="textPassword"
                android:background="@color/buyer_surface"
                android:paddingHorizontal="16dp"
                android:paddingEnd="50dp"
                android:textColor="@color/buyer_textPrimary"
                android:textColorHint="@color/buyer_textSecondary"
                android:elevation="2dp" />

            <ImageView
                android:id="@+id/ivTogglePassword"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_alignParentEnd="true"
                android:padding="16dp"
                android:elevation="2dp"
                android:src="@android:drawable/ic_menu_view"
                app:tint="@color/buyer_textSecondary" />
        </RelativeLayout>

        <!-- Konfirmasi Password -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp">

            <EditText
                android:id="@+id/etPasswordConf"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Ulangi Password"
                android:inputType="textPassword"
                android:background="@color/buyer_surface"
                android:paddingHorizontal="16dp"
                android:paddingEnd="50dp"
                android:textColor="@color/buyer_textPrimary"
                android:textColorHint="@color/buyer_textSecondary"
                android:elevation="2dp" />

            <ImageView
                android:id="@+id/ivTogglePasswordConf"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_alignParentEnd="true"
                android:padding="16dp"
                android:elevation="2dp"
                android:src="@android:drawable/ic_menu_view"
                app:tint="@color/buyer_textSecondary" />
        </RelativeLayout>

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Daftar Sekarang"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="@color/buyer_primary"
            app:cornerRadius="12dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sudah punya akun? "
                android:textColor="@color/buyer_textSecondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Masuk di sini"
                android:textStyle="bold"
                android:textColor="@color/buyer_primary"
                android:textSize="15sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>