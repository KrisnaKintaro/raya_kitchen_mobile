<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivGambarDetail"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="#EAEAEA"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNamaRotiDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Roti"
            android:textColor="@color/buyer_textPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHargaDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Rp 15.000 x 2"
            android:textColor="@color/buyer_textSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSubtotalDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:text="Rp 30.000"
        android:textColor="@color/buyer_primary"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>