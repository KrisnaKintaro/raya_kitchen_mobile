<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buyer_bg">

    <LinearLayout
        android:id="@+id/topBarAddAlamat"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBackAddAlamat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/buyer_textPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Form Alamat"
            android:textColor="@color/buyer_textPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btnSimpanAlamat"
        android:layout_below="@id/topBarAddAlamat"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_otp_box"
                android:clipToOutline="true">

                <org.osmdroid.views.MapView
                    android:id="@+id/mapView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Pin Merah di Tengah Peta -->
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_centerInParent="true"
                    android:layout_marginBottom="20dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    app:tint="#EF4444" /> <!-- Warna Merah -->

                <!-- Tombol Ambil Lokasi -->
                <Button
                    android:id="@+id/btnAmbilLokasi"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="12dp"
                    android:text="Gunakan Lokasi Ini"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/buyer_primary"
                    app:cornerRadius="8dp" />
            </RelativeLayout>

            <EditText android:id="@+id/etLabel" android:layout_width="match_parent" android:layout_height="55dp" android:hint="Label (cth: Rumah, Kantor)" android:textColor="@color/buyer_textPrimary" android:textColorHint="@color/buyer_textSecondary" android:background="@drawable/bg_otp_box" android:paddingHorizontal="16dp" android:layout_marginBottom="12dp"/>
            <EditText android:id="@+id/etNamaPenerima" android:layout_width="match_parent" android:layout_height="55dp" android:hint="Nama Penerima" android:textColor="@color/buyer_textPrimary" android:textColorHint="@color/buyer_textSecondary" android:background="@drawable/bg_otp_box" android:paddingHorizontal="16dp" android:layout_marginBottom="12dp"/>
            <EditText android:id="@+id/etWaPenerima" android:layout_width="match_parent" android:layout_height="55dp" android:hint="Nomor WA Penerima" android:inputType="phone" android:textColor="@color/buyer_textPrimary" android:textColorHint="@color/buyer_textSecondary" android:background="@drawable/bg_otp_box" android:paddingHorizontal="16dp" android:layout_marginBottom="12dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                <EditText android:id="@+id/etProvinsi" android:layout_width="0dp" android:layout_weight="1" android:layout_height="55dp" android:hint="Provinsi" android:textColor="@color/buyer_textPrimary" android:textColorHint="@color/buyer_textSecondary" android:background="@drawable/bg_otp_box" android:paddingHorizontal="16dp" android:layout_marginEnd="6dp"/>
                <EditText android:id="@+id/etKota" android:layout_width="0dp" android:layout_weight="1" android:layout_height="55dp" android:hint="Kota/Kab" android:textColor="@color/buyer_textPrimary" android:textColorHint="@color/buyer_textSecondary" android:background="@drawable/bg_otp_box" android:paddingHorizontal="16dp" android:layout_marginStart="6dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                <EditText android:id="@+id/etKecamatan" android:layout_width="0dp" android:layout_weight="1" android:layout_height="55dp" android:hint="Kecamatan" android:textColor="@color/buyer_textPrimary" android:textColorHint="@color/buyer_textSecondary" android:background="@drawable/bg_otp_box" android:paddingHorizontal="16dp" android:layout_marginEnd="6dp"/>
                <EditText android:id="@+id/etKodePos" android:layout_width="0dp" android:layout_weight="1" android:layout_height="55dp" android:hint="Kode Pos" android:inputType="number" android:textColor="@color/buyer_textPrimary" android:textColorHint="@color/buyer_textSecondary" android:background="@drawable/bg_otp_box" android:paddingHorizontal="16dp" android:layout_marginStart="6dp"/>
            </LinearLayout>

            <EditText android:id="@+id/etJalan" android:layout_width="match_parent" android:layout_height="55dp" android:hint="Nama Jalan / Detail Gedung" android:textColor="@color/buyer_textPrimary" android:textColorHint="@color/buyer_textSecondary" android:background="@drawable/bg_otp_box" android:paddingHorizontal="16dp" android:layout_marginBottom="12dp"/>
            <EditText android:id="@+id/etPatokan" android:layout_width="match_parent" android:layout_height="55dp" android:hint="Patokan (Opsional)" android:textColor="@color/buyer_textPrimary" android:textColorHint="@color/buyer_textSecondary" android:background="@drawable/bg_otp_box" android:paddingHorizontal="16dp" android:layout_marginBottom="16dp"/>

            <!-- Switch Jadikan Utama -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchUtama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jadikan sebagai Alamat Utama"
                android:textColor="@color/buyer_textPrimary"
                android:textStyle="bold"
                android:padding="8dp"
                android:layout_marginBottom="24dp"/>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnSimpanAlamat"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:text="Simpan Alamat"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:backgroundTint="@color/buyer_primary"
        app:cornerRadius="12dp" />

</RelativeLayout>