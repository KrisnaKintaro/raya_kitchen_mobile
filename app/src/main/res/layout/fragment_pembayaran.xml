<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buyer_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Selesaikan Pembayaran"
            android:textColor="@color/buyer_textPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Total yang harus dibayar:"
            android:textColor="@color/buyer_textSecondary" />

        <TextView
            android:id="@+id/tvTotalBayarTF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Rp 0"
            android:textColor="@color/buyer_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Kotak Rekening -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_otp_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bank BCA (A/N Raya Kitchen)"
                    android:textColor="@color/buyer_textSecondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvNoRekening"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="8123456789"
                    android:textColor="@color/buyer_textPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tombol Salin -->
            <ImageView
                android:id="@+id/btnSalinRekening"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/buyer_primary" />
        </LinearLayout>

        <!-- Preview Bukti Transfer -->
        <ImageView
            android:id="@+id/ivPreviewBukti"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="24dp"
            android:background="#EAEAEA"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            app:tint="@color/buyer_textSecondary" />

        <!-- Tombol Kamera & Galeri -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnKamera"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Kamera"
                android:textColor="@color/buyer_primary"
                app:strokeColor="@color/buyer_primary" />

            <Button
                android:id="@+id/btnGaleri"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Galeri"
                android:textColor="@color/buyer_primary"
                app:strokeColor="@color/buyer_primary" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Tombol Submit -->
        <Button
            android:id="@+id/btnUploadBukti"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:text="Upload &amp; Konfirmasi"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="@color/buyer_primary"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>